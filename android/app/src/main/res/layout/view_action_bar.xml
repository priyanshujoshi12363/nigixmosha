<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginStart="@dimen/screen_gutter"
    android:layout_marginEnd="@dimen/screen_gutter"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_bar"
    android:elevation="10dp"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/barInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">

        <LinearLayout
            android:id="@+id/barAvatars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/barText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/barSecondary"
            style="@style/Widget.Nigix.Button.Ghost.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            app:icon="@drawable/ic_script" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/barPrimary"
            style="@style/Widget.Nigix.Button.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:text="@string/produce"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd" />
    </LinearLayout>
</LinearLayout>
