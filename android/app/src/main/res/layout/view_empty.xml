<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_gutter"
    android:paddingTop="24dp"
    android:paddingEnd="@dimen/screen_gutter"
    android:paddingBottom="48dp"
    android:visibility="gone">

    <com.nigixmosha.app.ui.widget.WaveformView
        android:id="@+id/emptyWave"
        android:layout_width="168dp"
        android:layout_height="44dp" />

    <TextView
        style="@style/Text.Nigix.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="@string/empty_title"
        android:textSize="24sp" />

    <TextView
        style="@style/Text.Nigix.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:maxWidth="360dp"
        android:text="@string/empty_body" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/emptyAction"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginTop="28dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="@string/open_studio"
        app:icon="@drawable/ic_open_in_new"
        app:iconGravity="textEnd"
        app:iconSize="18dp" />
</LinearLayout>
