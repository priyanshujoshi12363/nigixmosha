<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.nigixmosha.app.ui.widget.BackdropView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="@dimen/welcome_logo"
            android:layout_height="@dimen/welcome_logo"
            android:contentDescription="@string/app_name"
            android:src="@drawable/avd_logo_blink" />

        <TextView
            android:id="@+id/wordmark"
            style="@style/Text.Nigix.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif"
            android:textSize="@dimen/welcome_wordmark" />

        <TextView
            android:id="@+id/tagline"
            style="@style/Text.Nigix.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:maxWidth="340dp"
            android:textSize="@dimen/welcome_tagline" />

        <com.nigixmosha.app.ui.widget.WaveformView
            android:id="@+id/wave"
            android:layout_width="@dimen/welcome_wave_width"
            android:layout_height="@dimen/welcome_wave_height"
            android:layout_marginTop="36dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingBottom="32dp">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="invisible"
            app:indicatorColor="@color/accent"
            app:trackColor="@color/stroke"
            app:trackCornerRadius="2dp"
            app:trackThickness="3dp" />

        <TextView
            android:id="@+id/status"
            style="@style/Text.Nigix.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:alpha="0"
            android:gravity="center"
            android:maxWidth="360dp"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retry"
            style="@style/Widget.Nigix.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/retry"
            android:visibility="gone"
            app:icon="@drawable/ic_refresh"
            app:iconSize="18dp" />

        <TextView
            android:id="@+id/signature"
            style="@style/Text.Nigix.Mono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:alpha="0"
            android:text="@string/made_by" />
    </LinearLayout>
</FrameLayout>
