<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Nigix.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/field_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/field_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/field_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/field_radius</item>
        <item name="hintTextColor">@color/accent</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="helperTextTextColor">@color/text_tertiary</item>
        <item name="errorTextColor">@color/error</item>
        <item name="boxStrokeErrorColor">@color/error</item>
        <item name="errorIconTint">@color/error</item>
        <item name="startIconTint">@color/field_icon</item>
        <item name="endIconTint">@color/field_icon</item>
        <item name="prefixTextColor">@color/text_tertiary</item>
    </style>

    <style name="Widget.Nigix.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/button_bg</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="iconTint">@color/on_accent</item>
    </style>

    <style name="Widget.Nigix.Button.Ghost" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/stroke_strong</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/text_primary</item>
    </style>

    <style name="Widget.Nigix.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/surface</item>
        <item name="shapeAppearance">@style/Shape.Nigix.Sheet</item>
    </style>

    <style name="Widget.Nigix.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/surface_highest</item>
        <item name="shapeAppearance">@style/Shape.Nigix.Snackbar</item>
    </style>

    <style name="Shape.Nigix.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Shape.Nigix.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="Shape.Nigix.Snackbar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="Shape.Nigix.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/card_radius</item>
    </style>

    <style name="Text.Nigix.Display" parent="">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.Nigix.Body" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="Text.Nigix.Mono" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Text.Nigix.CollapsedTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Nigix.ExpandedTitle" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">@dimen/home_expanded_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Widget.Nigix.TextInput.Compact" parent="Widget.Nigix.TextInput">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.Nigix.Dense</item>
    </style>

    <style name="ThemeOverlay.Nigix.Dense" parent="">
        <item name="editTextStyle">@style/Widget.Nigix.DenseEditText</item>
    </style>

    <style name="Widget.Nigix.DenseEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox.Dense" />

    <style name="Widget.Nigix.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/field_stroke</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/accent</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="endIconTint">@color/text_tertiary</item>
        <item name="helperTextTextColor">@color/text_tertiary</item>
    </style>

    <style name="Widget.Nigix.FilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipCornerRadius">999dp</item>
        <item name="android:textSize">13sp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <style name="Widget.Nigix.InfoChip" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/surface_high</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="chipCornerRadius">999dp</item>
        <item name="android:textSize">12sp</item>
        <item name="chipMinHeight">28dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="chipIconTint">@color/text_secondary</item>
        <item name="chipIconSize">14dp</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
    </style>

    <style name="Widget.Nigix.Button.Small" parent="Widget.Nigix.Button">
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Nigix.Button.Ghost.Small" parent="Widget.Nigix.Button.Ghost">
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconSize">16dp</item>
    </style>

    <style name="Widget.Nigix.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="iconTint">@color/text_tertiary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">999dp</item>
    </style>

    <style name="Widget.Nigix.Button.Danger" parent="Widget.Nigix.Button.Ghost.Small">
        <item name="android:textColor">@color/error</item>
        <item name="iconTint">@color/error</item>
        <item name="strokeColor">@color/error_stroke</item>
        <item name="backgroundTint">@color/error_bg</item>
    </style>

    <style name="Widget.Nigix.Slider" parent="Widget.Material3.Slider">
        <item name="thumbColor">@color/text_primary</item>
        <item name="trackColorActive">@color/accent</item>
        <item name="trackColorInactive">@color/stroke_strong</item>
        <item name="tickVisible">false</item>
        <item name="labelBehavior">gone</item>
    </style>

    <style name="Text.Nigix.Section" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Text.Nigix.Label" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Nigix.Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/stroke_strong</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="backgroundTint">@color/chip_bg</item>
    </style>
</resources>
